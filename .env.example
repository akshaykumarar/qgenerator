# =====================================================================
# Intelligent Procurement Assistant - Multi-Provider Configuration
# =====================================================================

# 1. Active Provider: 'gemini' | 'openai' | 'openrouter' | 'ollama'
LLM_PROVIDER=gemini

# 2. Active Model Name:
AI_MODEL=gemini-2.5-flash

# 3. Dynamic Model Options (comma-separated lists for UI dropdowns):
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-1.5-pro,gemini-1.5-flash
OPENAI_MODELS=gpt-4o,gpt-4o-mini,o3-mini,gpt-4-turbo
OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,deepseek/deepseek-r1,meta-llama/llama-3.3-70b-instruct,google/gemini-2.5-flash,mistralai/mistral-large-2411
OLLAMA_MODELS=llama3.2,mistral,qwen2.5:7b,deepseek-r1:8b,phi4,llava

# 4. Provider API Keys & Endpoints
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# 5. Normalization & Application Defaults
USD_INR_RATE=84.0
DATASET_DIR=./vendor_dataset
APP_TITLE=Autonomous RFx Normalization & Interrogation Engine
DEBUG=false
